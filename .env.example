# =============================================================================
# Embedding Provider
# =============================================================================
# Which model to use for turning document text into vectors.
# "sentence_transformers" runs locally (no API key, no cost, slower first load).
# "openai" uses OpenAI's embedding API (faster, requires OPENAI_API_KEY).
EMBEDDING_PROVIDER=sentence_transformers

# Required only when EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=

# =============================================================================
# LLM Provider (agent reasoning)
# =============================================================================
# Which LLM powers the Q&A agent.
# "anthropic" — Claude models via Anthropic API (requires ANTHROPIC_API_KEY).
# "openai"    — GPT models via OpenAI API (requires OPENAI_API_KEY).
# "ollama"    — local models via Ollama (no API key, see Ollama section below).
LLM_PROVIDER=anthropic

# Required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Required when LLM_PROVIDER=openai (can reuse the same key as OPENAI_API_KEY above).
# OPENAI_API_KEY=

# =============================================================================
# Ollama (local LLM — only needed when LLM_PROVIDER=ollama)
# =============================================================================
# Name of the Ollama model to use. Pull it first with: ollama pull llama3.1:8b
# OLLAMA_MODEL=llama3.1:8b
# Base URL of the Ollama server (default port is 11434).
# OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# ChromaDB Vector Store
# =============================================================================
# Directory on disk where ChromaDB persists its data between restarts.
CHROMA_PERSIST_DIR=./chroma_db
# Logical collection name inside ChromaDB. Change this to maintain separate
# corpora (e.g. "loans" vs "compliance") without touching the persist dir.
CHROMA_COLLECTION_NAME=doc_qa

# =============================================================================
# Chunking Parameters
# =============================================================================
# CHUNK_SIZE: target size of each text chunk in characters. Smaller chunks
# give more precise retrieval hits but lose surrounding context; larger chunks
# preserve context but may dilute relevance scores. 512 is a good default for
# dense banking documents.
CHUNK_SIZE=512

# CHUNK_OVERLAP: how many characters are shared between adjacent chunks.
# Overlap prevents answers from being split across chunk boundaries. Set to
# roughly 10–15% of CHUNK_SIZE (64 / 512 ≈ 12%).
CHUNK_OVERLAP=64

# MIN_CHUNK_CHARS: chunks shorter than this are discarded. Filters out page
# headers, footers, and other noise that would pollute search results.
MIN_CHUNK_CHARS=100

# PDF_OCR_THRESHOLD: if a PDF page yields fewer than this many characters via
# direct text extraction, the page is re-processed with OCR (pytesseract).
# Set to 0 to disable OCR entirely. Increase if scanned PDFs return blank pages.
PDF_OCR_THRESHOLD=50

# =============================================================================
# MLflow Observability
# =============================================================================
# Backend store for MLflow run data. Must match the --backend-store-uri flag
# used when starting the MLflow UI server (see: make mlflow).
# SQLite is required for MLflow 3.x GenAI features (traces, evaluation UI).
# For production, swap to a remote DB: postgresql://user:pass@host/db
# or an S3 artifact store: s3://your-bucket/mlruns
MLFLOW_TRACKING_URI=sqlite:///mlruns.db
# Name of the MLflow experiment that groups all ingestion and agent turn runs.
MLFLOW_EXPERIMENT_NAME=doc-qa-agent

# =============================================================================
# Retrieval
# =============================================================================
# DEFAULT_TOP_K: number of document chunks returned per search query.
# Higher values give the agent more context but increase prompt size and cost.
DEFAULT_TOP_K=5

# RETRIEVAL_SCORE_THRESHOLD: minimum similarity score (0.0–1.0) for a chunk
# to be included in results. 0.0 means no filtering — all top-k chunks are
# returned regardless of relevance. Raise this (e.g. 0.3) to suppress
# weakly-matching results.
RETRIEVAL_SCORE_THRESHOLD=0.0

# MAX_TOOL_RETRIES: how many times the agent may retry a search that returned
# no results before giving up and responding with an UNGROUNDED message.
MAX_TOOL_RETRIES=2

# =============================================================================
# API
# =============================================================================
# Base URL of the FastAPI backend, used by the Streamlit UI to send requests.
# Change this if you move the API to a different host or port.
API_BASE_URL=http://localhost:8000
